---
import '@fontsource-variable/josefin-sans';
import '@fontsource-variable/eb-garamond';
import '@fontsource-variable/vazirmatn';
import '../styles/global.css';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import logo from '../assets/logo.webp';
import { site, spokenLanguages } from '../data';
import { useI18n, locales, defaultLocale, pathFor, navKeys, footerKeys, getContent, type PageKey } from '../i18n';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  crumbs?: { label: string; href?: string }[];
  noindex?: boolean;
  route?: { key: PageKey; id?: string };
}

const { title, description, jsonLd: extraLd = [], crumbs, noindex = false, route } = Astro.props;
const { lang, c, p, therapists, services } = useI18n(Astro.url);
const jsonLd = [...extraLd];
if (crumbs) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ label: c.ui.start, href: p('home') }, ...crumbs].map((cr, i, all) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: cr.label,
      item: new URL(i === all.length - 1 ? Astro.url.pathname : cr.href ?? p('home'), site.url).href,
    })),
  });
}
const canonical = new URL(Astro.url.pathname, site.url).href;
const withBrand = `${title} | ${site.name}`;
const fullTitle = title.includes(site.name) || withBrand.length > 65 ? title : withBrand;
const path = Astro.url.pathname;
const ogImage = new URL('/og.jpg', site.url).href;
const ogAlt = `${therapists.map((t) => t.name).join(' / ')}, ${site.name}`;
const alternates = route ? locales.map((l) => ({ lang: l, href: new URL(pathFor(l, route.key, route.id), site.url).href, path: pathFor(l, route.key, route.id) })) : [];
const otherLangs = alternates.filter((a) => a.lang !== lang);

const amounts = services.flatMap((s) => s.prices.map((pr) => pr.amount));

const organization = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'LocalBusiness'],
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  description: c.orgDescription,
  email: site.email,
  telephone: therapists.map((t) => t.tel),
  image: ogImage,
  logo: new URL('/icon-512.png', site.url).href,
  legalName: site.legalName,
  foundingDate: String(site.foundedYear),
  priceRange: `${Math.min(...amounts)}–${Math.max(...amounts)} SEK`,
  medicalSpecialty: 'Psychiatric',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressCountry: 'SE',
  },
  areaServed: 'Stockholm',
  availableLanguage: [...spokenLanguages],
};
---

<!doctype html>
<html lang={c.htmlLang} dir={c.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.lang === defaultLocale)!.href} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={site.themeColor} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={c.ogLocale} />
    {otherLangs.map((a) => <meta property="og:locale:alternate" content={getContent(a.lang).ogLocale} />)}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="robots" content={noindex ? 'noindex' : 'max-image-preview:large'} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{c.ui.skip}</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href={p('home')} class="brand" aria-label={c.ui.brandLabel}>
          <Image src={logo} alt="" width={130} densities={[1, 2, 3]} loading="eager" />
        </a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label={c.ui.menuToggle} />
        <label for="nav-toggle" class="nav-button" aria-hidden="true">{c.ui.menu}</label>
        <nav class="site-nav" aria-label={c.ui.mainNav}>
          <ul>
            {navKeys.map((k) => (
              <li>
                <a href={p(k)} class:list={[{ cta: k === 'contact' }]} aria-current={path.startsWith(p(k)) ? 'page' : undefined}>{c.pageNames[k as keyof typeof c.pageNames]}</a>
              </li>
            ))}
            {alternates.length > 0 && (
              <li class="lang-menu">
                <details>
                  <summary aria-label={c.ui.langSwitch}><Icon name="languages" size={18} /><span>{c.native}</span></summary>
                  <ul>
                    {alternates.map((a) => (
                      <li><a href={a.path} hreflang={a.lang} lang={a.lang} aria-current={a.lang === lang ? 'true' : undefined}>{getContent(a.lang).native}</a></li>
                    ))}
                  </ul>
                </details>
              </li>
            )}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <h2>{site.name}</h2>
          <p>{c.orgDescription}</p>
          <address>
            {c.place}<br />
            {site.address.street}, {site.address.postalCode} {site.address.city}<br />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </address>
        </div>
        <nav aria-label={c.ui.footer.pagesNav}>
          <h2>{c.ui.footer.pagesTitle}</h2>
          <ul>
            {[...navKeys, ...footerKeys].map((k) => <li><a href={p(k)}>{c.pageNames[k as keyof typeof c.pageNames]}</a></li>)}
          </ul>
        </nav>
        <nav aria-label={c.ui.footer.servicesNav}>
          <h2>{c.ui.footer.servicesTitle}</h2>
          <ul>
            {services.map((s) => <li><a href={p('services', s.id)}>{s.title}</a></li>)}
          </ul>
        </nav>
      </div>
      <p class="copy">&copy; {site.foundedYear}–{new Date().getFullYear()} {site.legalName}</p>
    </footer>
  </body>
</html>
