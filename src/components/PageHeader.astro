---
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { title: string; crumbs: { href?: string; label: string }[] }
const { title, crumbs } = Astro.props;
---

<header class="page-header">
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <h1>{title}</h1>
    <p class="lead"><slot /></p>
  </div>
</header>
