---
import Icon from './Icon.astro';
interface Props { title?: string; text?: string; button?: string }
const {
  title = 'Vill du veta mer eller boka tid?',
  text = 'Hör av dig så hjälper vi dig vidare.',
  button = 'Kontakta oss',
} = Astro.props;
---

<section class="section" aria-labelledby="cta-title">
  <div class="wrap">
    <div class="cta-band">
      <span class="cta-icon" aria-hidden="true"><Icon name="message-heart" size={52} /></span>
      <div>
        <h2 id="cta-title">{title}</h2>
        <p>{text}</p>
      </div>
      <a class="button" href="/kontakt/">{button} <Icon name="arrow-right" size={18} /></a>
    </div>
  </div>
</section>
