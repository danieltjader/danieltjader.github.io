---
import Icon from './Icon.astro';
import { useI18n } from '../i18n';
const { c, p, services } = useI18n(Astro.url);
---

<ul class="card-grid">
  {services.map((s) => (
    <li>
      <article class="card">
        <span class="icon-badge"><Icon name={s.icon} /></span>
        <h3>{s.title}</h3>
        <p>{s.summary}</p>
        <a class="more" href={p('services', s.id)}>{c.ui.readMore} <Icon name="arrow-right" size={16} /><span class="sr-only"> {c.ui.about} {s.title}</span></a>
      </article>
    </li>
  ))}
</ul>
