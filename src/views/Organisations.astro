---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBox from '../components/CtaBox.astro';
import Icon from '../components/Icon.astro';
import vantrum from '../assets/vantrum.webp';
import { useI18n } from '../i18n';
const { c } = useI18n(Astro.url);
const pg = c.orgsPage;
const crumbs = [{ label: pg.crumb }];
const icons = ['clipboard-list', 'graduation-cap', 'stethoscope', 'users'] as const;
---

<Base title={pg.title} description={pg.description} crumbs={crumbs} route={{ key: 'organisations' }}>
  <PageHeader title={pg.h1} crumbs={crumbs}>{pg.lead}</PageHeader>
  <section class="section">
    <div class="wrap split even">
      <div class="prose">
        {pg.intro.map((para) => <p>{para}</p>)}
      </div>
      <Image class="portrait" src={vantrum} alt={pg.imgAlt} widths={[480, 720, 960]} sizes="(min-width: 860px) 500px, 100vw" loading="lazy" />
    </div>
  </section>
  <section class="section tint" aria-labelledby="uppdrag">
    <div class="wrap">
      <h2 id="uppdrag">{pg.h2}</h2>
      <ul class="card-grid">
        {pg.items.map((item, i) => (
          <li id={item.id}><article class="card static"><span class="icon-badge"><Icon name={icons[i]} /></span><h3>{item.title}</h3><p>{item.text}</p></article></li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBox title={pg.cta.title} text={pg.cta.text} button={pg.cta.button} />
</Base>
