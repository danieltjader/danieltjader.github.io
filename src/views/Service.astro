---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBox from '../components/CtaBox.astro';
import PriceTable from '../components/PriceTable.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data';
import { useI18n } from '../i18n';

const { id } = Astro.props;
const { c, p, services } = useI18n(Astro.url);
const s = services.find((x) => x.id === id)!;
const others = services.filter((o) => o.id !== s.id);
const crumbs = [{ label: c.pageNames.services, href: p('services') }, { label: s.title }];
---

<Base
  title={c.serviceDetail.title(s.title)}
  description={s.description}
  crumbs={crumbs}
  route={{ key: 'services', id: s.id }}
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.title,
    description: s.description,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: 'Stockholm',
  }]}
>
  <PageHeader title={s.title} crumbs={crumbs}>{s.summary}</PageHeader>
  <section class="section">
    <div class="wrap split">
      <div class="prose">
        {s.body.map((para) => <p>{para}</p>)}
        {s.prices.length > 0 && <PriceTable caption={c.serviceDetail.pricesCaption} prices={s.prices} />}
        {s.prices.length > 0 && <p class="note"><Icon name="banknote" size={18} /> {c.vatNote}</p>}
      </div>
      <aside class="aside-card">
        <span class="icon-badge"><Icon name={s.icon} /></span>
        <h2>{c.serviceDetail.aside.h2}</h2>
        <p>{c.serviceDetail.aside.text}</p>
        <a class="button" href={p('contact')}>{c.ui.contactUs} <Icon name="arrow-right" size={18} /></a>
      </aside>
    </div>
  </section>
  <section class="section tint" aria-labelledby="fler">
    <div class="wrap">
      <h2 id="fler">{c.serviceDetail.more}</h2>
      <ul class="card-grid">
        {others.map((o) => (
          <li>
            <a class="card" href={p('services', o.id)} style="text-decoration:none;color:inherit">
              <span class="icon-badge"><Icon name={o.icon} /></span>
              <h3>{o.title}</h3>
              <p>{o.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBox />
</Base>
