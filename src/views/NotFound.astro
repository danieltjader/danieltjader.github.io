---
import Base from '../layouts/Base.astro';
import { getContent, locales, pathFor } from '../i18n';
const c = getContent('sv');
const blocks = locales.map((l) => ({ lang: l, c: getContent(l) }));
---

<Base title={c.notFound.title} description={c.notFound.description} noindex>
  <section class="section">
    <div class="wrap prose">
      <p class="eyebrow">404</p>
      {blocks.map((b) => (
        <div lang={b.c.htmlLang} dir={b.c.dir} class="notfound-block">
          {b.lang === 'sv' ? <h1>{b.c.notFound.title}</h1> : <h2>{b.c.notFound.title}</h2>}
          <p>{b.c.notFound.text}</p>
          <p><a class="button" href={pathFor(b.lang, 'home')}>{b.c.notFound.button}</a></p>
        </div>
      ))}
    </div>
  </section>
</Base>
