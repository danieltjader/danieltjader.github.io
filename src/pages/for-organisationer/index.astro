---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBox from '../../components/CtaBox.astro';
import Icon from '../../components/Icon.astro';
import vantrum from '../../assets/vantrum.webp';
const crumbs = [{ label: 'För organisationer' }];
---

<Base
  title="För institutioner och organisationer"
  description="Handledning, konsultation, utbildning, psykologisk och psykosocial utredning samt nätverksarbete för socialtjänst, behandlingshem, försäkringsbolag och vårdcentraler."
  crumbs={crumbs}
>
  <PageHeader title="För organisationer" crumbs={crumbs}>Vi samarbetar med socialtjänst, behandlingshem, försäkringsbolag och vårdcentraler.</PageHeader>
  <section class="section">
    <div class="wrap split even">
      <div class="prose">
        <p>Vi erbjuder handledning, konsultation, utbildning, psykologisk och psykosocial utredning, psykiatrisk utredning och behandling samt nätverksarbete.</p>
        <p>Vi inleder gärna med ett möte där vi tillsammans med er utforskar förutsättningarna och tar reda på vad som är möjligt och hur vi kan vara till hjälp.</p>
      </div>
      <Image class="portrait" src={vantrum} alt="Väntrum på mottagningen" widths={[480, 720, 960]} sizes="(min-width: 860px) 500px, 100vw" loading="lazy" />
    </div>
  </section>
  <section class="section tint" aria-labelledby="uppdrag">
    <div class="wrap">
      <h2 id="uppdrag">Uppdrag vi tar</h2>
      <ul class="card-grid">
        <li id="utredning"><article class="card static"><span class="icon-badge"><Icon name="clipboard-list" /></span><h3>Psykologisk och psykosocial utredning</h3><p>Varje uppdrag blir ett samarbete mellan uppdragsgivarna, Dialogisk Praxis och de personer utredningen gäller. Frågeställningar och arbetsformer utformas tillsammans.</p></article></li>
        <li id="utbildning"><article class="card static"><span class="icon-badge"><Icon name="graduation-cap" /></span><h3>Utbildning och handledning</h3><p>Samtal med barn, trauma, sexuella övergrepp, våld och interkulturell kommunikation. Skräddarsydd efter er verksamhet.</p></article></li>
        <li><article class="card static"><span class="icon-badge"><Icon name="stethoscope" /></span><h3>Psykiatrisk utredning och behandling</h3><p>Kvalificerad utredning och behandling av psykisk ohälsa hos barn, ungdomar och vuxna.</p></article></li>
        <li><article class="card static"><span class="icon-badge"><Icon name="users" /></span><h3>Nätverksarbete och konsultation</h3><p>Samarbete runt personen tillsammans med socialtjänst, vård och andra aktörer.</p></article></li>
      </ul>
    </div>
  </section>
  <CtaBox title="Vill ni diskutera ett uppdrag?" text="Vi börjar gärna med ett möte för att utforska förutsättningarna." button="Kontakta oss" />
</Base>
