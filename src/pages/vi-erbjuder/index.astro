---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import CtaBox from '../../components/CtaBox.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data';
const crumbs = [{ label: 'Vi erbjuder' }];
---

<Base
  title="Vi erbjuder – psykiatri, psykoterapi och intyg"
  description="Psykiatrisk vård, psykoterapi, par- och familjeterapi, second opinion och intyg till myndigheter i Stockholm. Se vad vi erbjuder, vad det kostar och hur du bokar."
  crumbs={crumbs}
>
  <PageHeader title="Vi erbjuder" crumbs={crumbs}>Utredning, behandling och samtal för barn, ungdomar och vuxna – fysiskt eller digitalt.</PageHeader>
  <section class="section">
    <div class="wrap">
      <ServiceCards services={services} />
    </div>
  </section>
  <section class="section tint-green">
    <div class="wrap split even">
      <div>
        <h2>Företag och organisationer</h2>
        <p class="prose">Vi erbjuder också utredning, utbildning och handledning till socialtjänst, behandlingshem, försäkringsbolag och vårdcentraler.</p>
        <a class="button secondary" href="/for-organisationer/">Till organisationer</a>
      </div>
      <div>
        <h2>Vad kostar det?</h2>
        <p class="prose">Se alla priser samlade på ett ställe.</p>
        <a class="button secondary" href="/priser/"><Icon name="banknote" size={18} /> Se priser</a>
      </div>
    </div>
  </section>
  <CtaBox />
</Base>
