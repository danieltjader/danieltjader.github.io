---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import CtaBox from '../../components/CtaBox.astro';
import { therapists, site } from '../../data';

export function getStaticPaths() {
  return therapists.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
const crumbs = [{ label: 'Terapeuter', href: '/terapeuter/' }, { label: t.name }];
---

<Base
  title={`${t.name} – ${t.role}`}
  description={`${t.name}, ${t.role.toLowerCase()} i Stockholm. ${t.short}`}
  crumbs={crumbs}
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: t.name,
    jobTitle: t.role,
    email: t.email,
    telephone: t.tel,
    worksFor: { '@id': `${site.url}/#organization` },
  }]}
>
  <PageHeader title={t.name} crumbs={crumbs}>{t.role}</PageHeader>
  <section class="section">
    <div class="wrap split">
      <div class="prose">
        {t.bio.map((p) => <p>{p}</p>)}
      </div>
      <aside class="aside-card">
        <Image class="portrait" src={t.image} alt={t.alt} widths={[400, 640]} sizes="(min-width: 860px) 360px, 100vw" loading="eager" style="margin-bottom:1.25rem" />
        <h2>Kontakta {t.name.split(' ')[0]}</h2>
        <ul class="info-list">
          <li><span class="icon-badge"><Icon name="mail" size={22} /></span><div><strong>E-post</strong><a href={`mailto:${t.email}`}>{t.email}</a></div></li>
          <li><span class="icon-badge"><Icon name="phone" size={22} /></span><div><strong>Telefon</strong><a href={`tel:${t.tel}`}>{t.phone}</a></div></li>
        </ul>
      </aside>
    </div>
  </section>
  <CtaBox />
</Base>
