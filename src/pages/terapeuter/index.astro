---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Avatar from '../../components/Avatar.astro';
import Icon from '../../components/Icon.astro';
import CtaBox from '../../components/CtaBox.astro';
import { therapists } from '../../data';
const crumbs = [{ label: 'Terapeuter' }];
---

<Base
  title="Våra terapeuter – psykiater och psykoterapeut"
  description="Möt Hengameh Fransson, specialistläkare i psykiatri, och Siamak Noroozy, legitimerad psykoterapeut, hos Dialogisk Praxis i Stockholm."
  crumbs={crumbs}
>
  <PageHeader title="Våra terapeuter" crumbs={crumbs}>Möt psykiatern och psykoterapeuten du kan komma att träffa hos oss.</PageHeader>
  <section class="section">
    <div class="wrap">
      <ul class="card-grid two">
        {therapists.map((t) => (
          <li>
            <article class="card">
              <Avatar image={t.image} alt={t.alt} focus={t.focus} size={144} />
              <p class="role">{t.role}</p>
              <h2>{t.name}</h2>
              <p>{t.short}</p>
              <a class="more" href={`/terapeuter/${t.slug}/`}>Läs mer <Icon name="arrow-right" size={16} /><span class="sr-only"> om {t.name}</span></a>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBox />
</Base>
