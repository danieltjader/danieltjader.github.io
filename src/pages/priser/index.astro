---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PriceTable from '../../components/PriceTable.astro';
import CtaBox from '../../components/CtaBox.astro';
import Icon from '../../components/Icon.astro';
import { services, site } from '../../data';
const crumbs = [{ label: 'Priser' }];
---

<Base
  title="Priser – psykoterapi och läkarbesök i Stockholm"
  description="Priser för psykoterapi, parterapi, familjeterapi, läkarbesök och intyg hos Dialogisk Praxis i Stockholm. Alla priser inklusive moms, 0 % på hälsovård."
  crumbs={crumbs}
>
  <PageHeader title="Priser" crumbs={crumbs}>Tydliga priser för våra vanligaste tjänster.</PageHeader>
  <section class="section">
    <div class="wrap prose">
      {services.filter((s) => s.prices.length).map((s) => (
        <PriceTable caption={s.title} prices={s.prices} />
      ))}
      <p class="note"><Icon name="banknote" size={18} /> {site.vatNote}</p>
      <p>Gäller det utredning, utbildning eller handledning för organisationer? <a href="/for-organisationer/">Läs mer här</a> eller kontakta oss för offert.</p>
    </div>
  </section>
  <CtaBox />
</Base>
